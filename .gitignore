# 白名单模式：默认全部忽略，只放行下面列出的类型
*
!*.md
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.webp

# 放行目录，否则进不去子目录
!*/

# 本文件自身也要提交
!/.gitignore
!/.gitattributes

# homework2 演示视频
!homework2/video/*.mp4

# ---- homework2/LEDflow：放行 STM32 工程源码（build/ 产物仍被忽略）----
!homework2/LEDflow/*.ioc
!homework2/LEDflow/CMakeLists.txt
!homework2/LEDflow/CMakePresets.json
!homework2/LEDflow/*.ld
!homework2/LEDflow/*.s
!homework2/LEDflow/Core/**/*.c
!homework2/LEDflow/Core/**/*.h
!homework2/LEDflow/cmake/**/*.cmake
!homework2/LEDflow/cmake/**/*.txt
!homework2/LEDflow/Drivers/**/*.c
!homework2/LEDflow/Drivers/**/*.h
!homework2/LEDflow/Drivers/**/*.txt
!homework2/LEDflow/Middlewares/**/*.c
!homework2/LEDflow/Middlewares/**/*.h
!homework2/LEDflow/Middlewares/**/*.txt
!homework2/LEDflow/Middlewares/**/LICENSE

# ---- homework3/LEDflow：放行 STM32 工程源码（build/ 产物仍被忽略）----
!homework3/LEDflow/*.ioc
!homework3/LEDflow/*.ld
!homework3/LEDflow/*.s
!homework3/LEDflow/CMakeLists.txt
!homework3/LEDflow/CMakePresets.json
!homework3/LEDflow/Core/**/*.c
!homework3/LEDflow/Core/**/*.h
!homework3/LEDflow/cmake/**/*.cmake
!homework3/LEDflow/cmake/**/*.txt
!homework3/LEDflow/Drivers/**/*.c
!homework3/LEDflow/Drivers/**/*.h
!homework3/LEDflow/Drivers/**/*.txt

# 本地笔记不上传
homework3/.workbuddy/

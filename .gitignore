# 白名单模式：默认全部忽略，只放行下面列出的类型
*
!*.md
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.webp

# 放行目录，否则进不去子目录
!*/

# 本文件自身也要提交
!/.gitignore

# ---- homework2/LEDflow：放行 STM32 工程源码（build/ 产物仍被忽略）----
!homework2/LEDflow/*.ioc
!homework2/LEDflow/CMakeLists.txt
!homework2/LEDflow/CMakePresets.json
!homework2/LEDflow/*.ld
!homework2/LEDflow/*.s
!homework2/LEDflow/Core/**/*.c
!homework2/LEDflow/Core/**/*.h
!homework2/LEDflow/cmake/**/*.cmake
!homework2/LEDflow/cmake/**/*.txt
!homework2/LEDflow/Drivers/**/*.c
!homework2/LEDflow/Drivers/**/*.h
!homework2/LEDflow/Drivers/**/*.txt
